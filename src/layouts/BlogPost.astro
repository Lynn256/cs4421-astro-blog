---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import AuthorBio from '../components/AuthorBio.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, heroImageAlt, category, author } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: 100%;
				max-width: none;
				margin: 0 auto;
				padding: 2rem 0 4rem;
			}
			.hero-image {
				width: min(1120px, calc(100% - 3rem));
				margin: 0 auto;
			}
			.hero-image img {
				display: block;
				width: 100%;
				max-height: 560px;
				margin: 0 auto;
				border-radius: 1rem;
				object-fit: cover;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: min(740px, calc(100% - 2rem));
				margin: auto;
				padding: 2.5rem 0 1rem;
				color: var(--ink);
			}
			.title {
				margin-bottom: 2rem;
				padding-bottom: 1.5rem;
				border-bottom: 1px solid var(--line);
			}
			.title h1 {
				margin: 0.4rem 0 0.8rem;
				font-size: clamp(2.5rem, 6vw, 4rem);
			}
			.date {
				margin: 0;
				color: var(--muted);
				font-size: 0.82rem;
			}
			.last-updated-on {
				font-style: italic;
			}
			.category {
				margin: 0;
				color: var(--accent);
				font-size: 0.75rem;
				font-weight: 700;
				letter-spacing: 0.12em;
				text-transform: uppercase;
			}
			@media (max-width: 720px) {
				.hero-image {
					width: calc(100% - 2rem);
				}
				.prose {
					padding-top: 1.7rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <img src={heroImage} alt={heroImageAlt ?? ''} fetchpriority="high" />}
				</div>
				<div class="prose">
					<div class="title">
						<p class="category">{category}</p>
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
					</div>
					<slot />
					{author && <AuthorBio authorId={author} />}
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
