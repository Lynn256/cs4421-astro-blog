---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav aria-label="Main navigation">
		<a class="brand" href="/" aria-label={`${SITE_TITLE} home`}>
			<svg viewBox="0 0 32 32" aria-hidden="true">
				<path d="M25.6 5.3C15 5.4 7.2 8.8 6.4 16c-.5 4.7 2.8 7.5 6.8 7.4 8.1-.3 10.1-9.6 12.4-18.1ZM8.3 27c2.3-6.3 6.7-10.8 13.1-14.6" />
			</svg>
			<span>{SITE_TITLE}<small>Nature, noticed.</small></span>
		</a>
		<div class="internal-links" aria-label="Pages">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Field notes</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
	</nav>
</header>

<style>
	header {
		position: relative;
		z-index: 1;
		padding: 0 max(1.5rem, calc((100vw - 1120px) / 2));
		background: var(--paper);
		border-bottom: 1px solid var(--line);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: 84px;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		color: var(--ink);
		font-size: 1.25rem;
		font-weight: 700;
		line-height: 1.1;
		text-decoration: none;
	}
	.brand svg {
		width: 34px;
		height: 34px;
		fill: none;
		stroke: var(--accent);
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 2;
	}
	.brand small {
		display: block;
		margin-top: 0.2rem;
		color: var(--muted);
		font-size: 0.62rem;
		font-weight: 400;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 1.8rem;
	}
	.internal-links a {
		padding: 0.45rem 0;
		color: var(--muted);
		font-size: 0.88rem;
		font-weight: 700;
		text-decoration: none;
		transition: color 160ms ease;
	}
	.internal-links a:hover,
	.internal-links a.active {
		color: var(--accent-dark);
	}
	@media (max-width: 720px) {
		header {
			padding: 0 1rem;
		}
		nav {
			min-height: 72px;
		}
		.internal-links {
			gap: 1rem;
		}
		.internal-links a {
			font-size: 0.8rem;
		}
	}
	@media (max-width: 420px) {
		.internal-links {
			gap: 0.65rem;
		}
	}
</style>
