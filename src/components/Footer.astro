---
const today = new Date();
---

<footer>
	<p>Stories from the wild, written with care.</p>
	<span>&copy; {today.getFullYear()} Lynn Christa · Wild Notes</span>
</footer>

<style>
	footer {
		padding: 2.5rem 1rem;
		border-top: 1px solid var(--line);
		background: #f1f1e8;
		color: var(--muted);
		text-align: center;
	}
	footer p {
		margin: 0 0 0.35rem;
		color: var(--accent-dark);
		font-weight: 700;
	}
	footer span {
		font-size: 0.8rem;
	}
</style>
